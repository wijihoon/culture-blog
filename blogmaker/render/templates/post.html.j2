{%- set HR = '<hr style="border:0;border-top:1px solid #d6d6d6;width:60%;margin:38px auto;">' -%}
{%- set DOT = '<p style="text-align:center;margin:18px 0;line-height:1;"><span style="color:#c9a4c4;font-size:13pt;"><b>·&nbsp;&nbsp;·&nbsp;&nbsp;·</b></span></p>' -%}
{%- macro title(t) -%}
<p style="text-align:center;margin:0 0 16px;line-height:1.7;"><span style="color:#ff0010;font-size:13pt;"><b>*{{ t }}*</b></span></p>
{%- endmacro -%}
{%- macro line(l, mb=0) -%}
<p style="text-align:center;margin:0 0 {{ mb }}px;line-height:1.7;">{{ line_html(l.text, l.style) }}</p>
{%- endmacro -%}
{%- macro slot(ids) -%}
{%- set s = slot_text(post, ids) -%}
{%- if s -%}
<p style="text-align:center;margin:0;line-height:1.7;"><span style="color:#1a5fb4;font-size:11pt;"><b>{{ s }}</b></span></p>
<p style="text-align:center;margin:4px 0 22px;"><span style="color:#888;font-size:9pt;">출처-{{ seller }} 상품 상세</span></p>
{%- endif -%}
{%- endmacro -%}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ short_title }} 블로그 초안</title>
<link rel="stylesheet" href="../../assets/site.css">
</head>
<body>
<div class="wrap">

<nav class="topnav"><a href="../../index.html">← 목록</a><a href="../../upload.html">+ 새 글 만들기</a></nav>

{% if post.warnings %}<div class="warn">{% for w in post.warnings %}<p>⚠ {{ w }}</p>{% endfor %}</div>{% endif %}

<p class="guide">사용법: ① 제목·본문·태그를 각각 <b>복사</b>해 네이버 글쓰기에 붙여넣기 → ② 아래 <b>사진</b> 칸에서 사진 내려받기 → ③ 본문의 파란 <b>[사진 번호 넣기]</b> 줄을 지우고 같은 번호 사진 넣기 (2장 나란히는 두 장을 함께 선택).<br>
예매 링크는 본문 맨 위 주소 줄에 직접 링크를 걸고, 지도는 파란 <b>[지도 넣기]</b> 줄을 지운 뒤 글쓰기 상단 '장소' 버튼에서 적힌 검색어로 찾아 넣으세요.</p>

<div class="box">
  <div class="box-head"><div><b>제목</b></div><button class="copy" data-target="title">복사</button></div>
  <div class="box-body" id="title">{{ d.blog_title }}</div>
</div>

<div class="box">
  <div class="box-head"><div><b>본문</b><span>서식 포함 복사</span></div><button class="copy" data-target="post">복사</button></div>
  <div id="post">

<p style="text-align:center;margin:0;line-height:1.7;"><span style="color:#ff0010;font-size:11pt;"><b>*&lt;{{ short_title }}&gt; 예매는</b></span></p>
<p style="text-align:center;margin:0 0 10px;line-height:1.7;"><span style="color:#ff0010;font-size:11pt;"><b>아래 링크 참조*</b></span></p>
<p style="text-align:center;margin:0 0 20px;line-height:1.7;"><span style="color:#000000;font-size:10pt;">{{ post.info.source_url }}</span></p>

{{ HR|safe }}

{% for k in d.keywords -%}
{% if loop.first %}<p style="text-align:center;margin:0;line-height:1.7;"><span style="color:#ff0010;font-size:13pt;"><b>{{ k }}</b></span></p>
{% else %}<p style="text-align:center;margin:0 0 {{ 20 if loop.last else 0 }}px;line-height:1.7;"><span style="color:#000000;font-size:13pt;"><i><b>{{ k }}</b></i></span></p>
{% endif %}{%- endfor %}
{{ slot([d.hero_image_id] if d.hero_image_id else []) }}

{{ HR|safe }}

{{ title("작품 소개") }}
{% for l in d.intro %}{{ line(l, 20 if loop.last and not d.intro_note else 0) }}
{% endfor %}
{% if d.intro_note %}<p style="text-align:center;margin:0 0 20px;line-height:1.7;"><span style="color:#888;font-size:9pt;">{{ d.intro_note }}</span></p>{% endif %}
{{ slot([d.intro_image_id] if d.intro_image_id else []) }}

{{ HR|safe }}

<p style="text-align:center;margin:0 0 10px;line-height:1.7;"><span style="color:#ff0010;font-size:13pt;"><b>-{{ '전시' if '전시' in (post.info.genre or '') else '공연' }} 기본 정보-</b></span></p>
<table style="width:100%;max-width:560px;margin:0 auto 26px;border-collapse:collapse;">
<tbody>
{% for label, value in rows -%}
<tr><td style="width:28%;padding:11px 12px;background:#f7eef6;border:1px solid #e8d6e5;color:#bc61ab;font-size:11pt;font-weight:bold;text-align:center;vertical-align:middle;white-space:nowrap;">{{ label }}</td><td style="padding:11px 14px;background:#ffffff;border:1px solid #e8d6e5;color:#222222;font-size:11pt;text-align:center;vertical-align:middle;line-height:1.6;">{{ value }}</td></tr>
{% endfor -%}
</tbody>
</table>

{% if d.recommend %}
{{ HR|safe }}

{{ title("추천 포인트") }}
{% for g in d.recommend -%}
{% if not loop.first %}{{ DOT|safe }}
{% endif %}{% for l in g.lines %}{{ line(l, 18 if loop.last else 0) }}
{% endfor %}{{ slot(g.image_ids) if g.image_ids|length <= 1 else '' }}{% if g.image_ids|length > 1 %}{% for i in g.image_ids %}{{ slot([i]) }}{% endfor %}{% endif %}
{% endfor %}
{% endif %}

{% if d.reviews %}
{{ HR|safe }}

{{ title("언론 리뷰") }}
{% for r in d.reviews -%}
<p style="text-align:center;margin:0;line-height:1.7;"><span style="color:#ff0010;font-size:11pt;"><b>★★★★★</b></span></p>
<p style="text-align:center;margin:0;line-height:1.7;"><span style="color:#000000;font-size:11pt;"><b>{{ r.text }}</b></span></p>
<p style="text-align:center;margin:0 0 10px;line-height:1.7;"><span style="color:#888;font-size:9pt;">- {{ r.source }}</span></p>
{% endfor -%}
<p style="text-align:center;margin:0 0 20px;line-height:1.7;"><span style="color:#888;font-size:9pt;">(리뷰는 {{ seller }} 상품 상세 소개 기준)</span></p>
{% endif %}

{% if d.highlights and d.highlights.items %}
{{ HR|safe }}

{% if d.highlights.lead %}<p style="text-align:center;margin:0 0 6px;line-height:1.7;"><span style="color:#000000;font-size:11pt;">{{ d.highlights.lead }}</span></p>{% endif %}
{{ title(d.highlights.section_title) }}
{% for it in d.highlights.items -%}
{% if not loop.first %}{{ DOT|safe }}
{% endif %}{% if it.subtitle %}<p style="text-align:center;margin:0;line-height:1.7;"><span style="color:#bc61ab;font-size:11pt;">{{ it.subtitle }}</span></p>
{% endif %}{% if it.title %}<p style="text-align:center;margin:0 0 14px;line-height:1.7;"><span style="color:#bc61ab;font-size:13pt;"><b>{{ it.title }}</b></span></p>
{% endif %}{% if it.image_ids|length <= 2 %}{{ slot(it.image_ids) }}{% else %}{{ slot(it.image_ids[:1]) }}{{ slot(it.image_ids[1:3]) }}{% endif %}
{% endfor %}
{% endif %}

{% if d.tips %}
{{ HR|safe }}

{{ title("관람 전 체크") }}
{% for l in d.tips %}{{ line(l, 12 if loop.index is even else 0) }}
{% endfor %}
{% endif %}

{{ HR|safe }}

{{ title("오시는 길") }}
{{ slot([d.map_image_id] if d.map_image_id else []) }}
{% if post.info.venue %}<p style="text-align:center;margin:0;line-height:1.7;"><span style="color:#bc61ab;font-size:11pt;"><b>{{ post.info.venue }}</b></span></p>{% endif %}
<p style="text-align:center;margin:0 0 24px;line-height:1.7;"><span style="color:#1a5fb4;font-size:11pt;"><b>[지도 넣기 · 장소 검색: {{ d.venue_search or post.info.venue }}]</b></span></p>

{{ HR|safe }}

{% for c in d.closing %}<p style="text-align:center;margin:0;line-height:1.7;"><span style="color:#bc61ab;font-size:13pt;"><b>{{ c }}</b></span></p>
{% endfor %}

{{ HR|safe }}

  </div>
</div>

<div class="box">
  <div class="box-head"><div><b>사진</b><span>본문 [사진 번호] 자리에 같은 번호를 넣으세요</span></div>
    <a class="copy" href="images.zip" download="{{ post.id }}_images.zip">전체 다운로드(zip)</a></div>
  <div class="box-body dl-grid">
  {% for im in post.images %}
    <div class="dl-item"><img src="{{ im.file }}" alt="사진 {{ '%02d' % im.num }}" loading="lazy">
      <div class="dl-meta"><b>사진 {{ '%02d' % im.num }}</b><span>{{ im.label }}</span>
      <a class="dl-btn" href="{{ im.file }}" download>다운로드</a></div></div>
  {% else %}
    <p class="muted">사용한 사진이 없습니다.</p>
  {% endfor %}
  </div>
</div>

<div class="box">
  <div class="box-head"><div><b>태그</b><span>띄어쓰기로 구분</span></div><button class="copy" data-target="tags">복사</button></div>
  <div class="box-body" id="tags">{{ d.tags|join(' ') }}</div>
</div>

<p class="foot">작성 방식: {{ {'claude': 'Claude (' ~ post.model ~ ')', 'rules': '규칙 기반', 'manual': '직접 작성'}[post.mode] }} · 생성 {{ post.created_at[:16]|replace('T', ' ') }} · 원본 <a href="{{ post.info.source_url }}" target="_blank" rel="noopener">{{ seller }}</a></p>

</div>
<script src="../../assets/copy.js"></script>
</body>
</html>
